{
  "name": "urbanthread-backend",
  "version": "1.0.0",
  "description": "Backend API for UrbanThread E-commerce Platform",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "dev:debug": "tsx watch --inspect server.ts",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "seed": "tsx utils/seedData.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "promote-admin": "tsx scripts/createAdmin.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ecommerce",
    "api",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/express": "^2.0.4",
    "@prisma/client": "^5.22.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "imagekit": "^6.0.0",
    "ioredis": "^5.10.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.6",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
