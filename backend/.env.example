# ──────────────────────────────────────────────────────────────────────────
# Urban Thread Backend — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development         # development | production | test
LOG_LEVEL=info               # error | warn | info | debug

# ── Neon DB (PostgreSQL via Prisma) ───────────────────────────────────────
# Get these from https://console.neon.tech → your project → Connection Details
# DATABASE_URL      — pooled connection (for app queries, uses PgBouncer)
# DATABASE_URL_UNPOOLED — direct connection (for Prisma migrations only)
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require&pgbouncer=true
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# ── Redis (Caching + Rate Limiting) ──────────────────────────────────────
# Local dev: redis://127.0.0.1:6379
# Production: use Upstash, Railway Redis, or AWS ElastiCache
REDIS_URL=redis://127.0.0.1:6379

# ── Clerk (Authentication) ─────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ── CORS ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.vercel.app

# ── ImageKit ──────────────────────────────────────────────────────────────
ImagekitID=your_imagekit_account_id
PUBLIC_KEY=public_your_imagekit_public_key
PRIVATE_KEY=private_your_imagekit_private_key

# ── Razorpay ──────────────────────────────────────────────────────────────
# Use TEST keys in development; switch to LIVE keys only in production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
